# Example systemd service file for DirForge.
# Copy to /etc/systemd/system/dirforge.service and adjust paths/user as needed.

[Unit]
Description=DirForge - Directory Listing Web App
After=network.target

[Service]
Type=notify
ExecStart=/opt/dirforge/DirForge
WorkingDirectory=/opt/dirforge
User=dirforge
Restart=on-failure
RestartSec=5

# Hardening
# ProtectHome=true makes /home, /root and /run/user fully inaccessible.
# If your RootPath lives under /home, change this to ProtectHome=read-only.
# ProtectSystem=strict mounts everything else read-only except ReadWritePaths.
# DirForge only reads user files, so RootPath does not need to be writable.
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/opt/dirforge

[Install]
WantedBy=multi-user.target
